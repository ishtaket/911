APP_ENV=development
APP_REGION=IL
APP_LANGUAGES=en,he,ru

DATABASE_URL=postgresql+psycopg://osint:osint@localhost:5432/osint
REDIS_URL=redis://localhost:6379/0
OPENSEARCH_URL=http://localhost:9200
QDRANT_URL=http://localhost:6333
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=osint-cases
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123

BRAVE_SEARCH_API_KEY=
GOOGLE_MAPS_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
LOCATIONIQ_API_KEY=

OPENAI_API_KEY=
GEOSEER_API_KEY=
PICARTA_API_KEY=
AZURE_VISION_ENDPOINT=
AZURE_VISION_KEY=

YOUTUBE_API_KEY=
GOOGLE_VISION_API_KEY=
GOOGLE_KG_API_KEY=
# Google Custom Search JSON API (Programmable Search) — primary web provider.
# Both must be set together. The Custom Search JSON API may be unavailable
# for new Google Cloud projects; if 403 is returned the backend surfaces
# the provider as not_configured with a clear error message.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ENGINE_ID=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# OAuth flow placeholders (backend-only — never ship to Android)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Web-search alternates
SERPAPI_API_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

MOCK_PROVIDERS=true
