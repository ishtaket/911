APP_ENV=development
APP_REGION=IL
APP_LANGUAGES=en,he,ru

DATABASE_URL=postgresql+psycopg://osint:osint@localhost:5432/osint
REDIS_URL=redis://localhost:6379/0
OPENSEARCH_URL=http://localhost:9200
QDRANT_URL=http://localhost:6333
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=osint-cases
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123

BRAVE_SEARCH_API_KEY=
GOOGLE_MAPS_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
LOCATIONIQ_API_KEY=

OPENAI_API_KEY=
GEOSEER_API_KEY=
PICARTA_API_KEY=
AZURE_VISION_ENDPOINT=
AZURE_VISION_KEY=

YOUTUBE_API_KEY=
GOOGLE_VISION_API_KEY=
GOOGLE_KG_API_KEY=
# Google Custom Search JSON API (Programmable Search) — primary web provider.
# Both must be set together. The Custom Search JSON API may be unavailable
# for new Google Cloud projects; if 403 is returned the backend surfaces
# the provider as not_configured with a clear error message.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ENGINE_ID=
# Custom Search Site Restricted JSON API was retired by Google on
# 2025-01-08. Set to true ONLY if Google has restored access for your
# Cloud project; the provider otherwise stays unavailable. Migrate to
# Vertex AI Search (below) instead.
GOOGLE_CSE_SITE_RESTRICTED_ENABLED=false
# Vertex AI Search (Agent Search / Discovery Engine) — official Google
# migration path for retired Site Restricted JSON API. The searchLite
# method below uses the API key + a public-website data store. Steps:
#   1. Console -> AI Applications -> Data Stores -> Create data store
#   2. Source = Website Content; add up to N public sites
#   3. Create an Agent / Engine; note its engine ID
#   4. Create / restrict an API key (HTTP referer or
#      https://discoveryengine.googleapis.com/* recommended)
# Then set:
VERTEX_AI_SEARCH_ENABLED=false
VERTEX_AI_PROJECT_ID=
VERTEX_AI_LOCATION=global
VERTEX_AI_ENGINE_ID=
VERTEX_AI_SERVING_CONFIG=default_search
VERTEX_AI_COLLECTION=default_collection
# Falls back to GOOGLE_CSE_API_KEY when this is empty.
VERTEX_AI_API_KEY=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# OAuth flow placeholders (backend-only — never ship to Android)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Web-search alternates
SERPAPI_API_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

MOCK_PROVIDERS=true
