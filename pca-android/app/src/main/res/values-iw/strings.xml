    <string name="onb_welcome_title">ברוכים הבאים ל-PCA</string>
    <string name="onb_welcome_body">עוזר הקשר אישי. מאזין בחלונות של 5 דקות, מעריך את המצב מקומית ומציע הצעה רק כשהיא באמת מועילה. STT, מסד נתונים והטמעות נשארים על המכשיר.</string>
    <string name="onb_consent_title">הסכמה</string>
    <string name="onb_consent_body">PCA מקליט את המיקרופון ברציפות. בחלק מהמדינות הקלטת שיחות מחייבת הסכמת כל הצדדים. בלחיצה על אישור אתה מקבל אחריות לעמידה בחוק במדינתך.</string>
    <string name="onb_consent_accept">הבנתי ואני מסכים</string>
    <string name="onb_perms_title">הרשאות</string>
    <string name="onb_perms_body">ל-PCA דרושים מיקרופון, התראות ומיקום. מיקום ברקע אופציונלי אך מאפשר את הגדר "אל תקליט בבית".</string>
    <string name="onb_perms_grant">הענק הרשאות</string>
    <string name="onb_enroll_title">רישום הבעלים</string>
    <string name="onb_enroll_body">אמת את זהותך עם ביומטריה ולאחר מכן אמור את חמש המשפטים כדי ש-PCA יוכל להבדיל את קולך מאחרים בקרבת מקום. ההטבעה הקולית מוצפנת ב-Android Keystore ולא יוצאת מהמכשיר.</string>
    <string name="onb_enroll_biometric">אמת ביומטריה</string>
