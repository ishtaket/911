    <!-- Onboarding -->
    <string name="onb_welcome_title">Welcome to PCA</string>
    <string name="onb_welcome_body">A personal context assistant that listens in 5-minute windows, evaluates the situation locally, and surfaces a proactive suggestion only when it truly helps. STT, DB, and embeddings stay on this device.</string>
    <string name="onb_consent_title">Consent</string>
    <string name="onb_consent_body">PCA continuously records the microphone. In some jurisdictions recording conversations requires the consent of all parties. By tapping Accept you confirm responsibility for legal compliance in your country.</string>
    <string name="onb_consent_accept">I understand and accept</string>
    <string name="onb_perms_title">Permissions</string>
    <string name="onb_perms_body">PCA needs microphone, notifications, and location access. Background location is optional but enables the "do not record at home" geofence.</string>
    <string name="onb_perms_grant">Grant permissions</string>
    <string name="onb_enroll_title">Owner enrollment</string>
    <string name="onb_enroll_body">Confirm your identity with biometrics, then say the five reference phrases so PCA can distinguish your voice from others nearby. The voice embedding is encrypted in Android Keystore and never leaves the device.</string>
    <string name="onb_enroll_biometric">Verify biometrics</string>
    <string name="onb_enroll_phrase">Phrase %1$d / 5: "%2$s"</string>
    <string name="onb_enroll_record">Record phrase</string>
    <string name="onb_enroll_done">Enrollment complete</string>
    <string name="onb_finish_title">All set</string>
    <string name="onb_finish_body">PCA will now run quietly in the background. Open the dashboard to see live windows or stop the service at any time.</string>
    <string name="onb_start">Start listening</string>

